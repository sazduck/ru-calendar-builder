{
  "name": "ru-calendar-builder",
  "version": "0.5.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ru-calendar-builder": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm test:run && pnpm typecheck",
    "build:js": "esbuild src/index.ts src/bin/main.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outdir=dist --entry-names=[name]",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist --rootDir src",
    "build": "pnpm build:js && pnpm build:types",
    "start": "node dist/main.js",
    "dev": "tsx src/bin/main.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
