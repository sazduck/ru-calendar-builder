{
  "name": "ru-calendar-builder",
  "version": "0.5.0",
  "description": "",
  "keywords": [
    "calendar",
    "russia",
    "holidays",
    "temporal",
    "esm",
    "dayoff",
    "transfers"
  ],
  "engines": {
    "node": ">=24.0.0",
    "deno": ">=2.0.0",
    "bun": ">=1.2.0"
  },
  "browserslist": [
    "supports temporal"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ru-calendar-builder": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run test:run && npm run typecheck",
    "build:js": "esbuild src/index.ts src/bin/main.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outdir=dist --entry-names=[name]",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:js && npm run build:types",
    "start": "node dist/main.js",
    "dev": "tsx src/bin/main.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "temporal-spec": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
