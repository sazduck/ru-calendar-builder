{
  "name": "ru-calendar-builder",
  "devDependencies": {
    "@types/node": "^25.9.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "bin": {
    "ru-cal": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "pn test:run && pn typecheck",
    "build": "esbuild src/bin/main.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "tsx src/bin/main.ts"
  }
}
