{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./src/lib/*"],
      "@bin/*": ["./src/bin/*"],
    },

    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "ESNext",

    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    "lib": ["esnext"],
    "types": ["node"],
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules"],
}
